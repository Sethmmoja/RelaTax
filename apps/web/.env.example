# Base URL of the RelaTax API, including the /api/v1 prefix. Baked into the
# client bundle at build time, so it must be set before `next build` — changing
# it later requires a rebuild, not just a restart.
# Production: NEXT_PUBLIC_API_URL="https://api.relatax.org/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
