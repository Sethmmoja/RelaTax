# Copy to .env for local development
DATABASE_URL="postgresql://relatax:relatax@localhost:5432/relatax"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="relatax-documents"
STORAGE_ACCESS_KEY="relatax"
STORAGE_SECRET_KEY="relatax123"
STORAGE_FORCE_PATH_STYLE="true"

# WhatsApp: set WHATSAPP_TRANSPORT=meta + the three vars below to send/receive
# via the real Meta Cloud API. Get them from the Meta App Dashboard — see
# docs/architecture/whatsapp-flows.md for the exact steps.
WHATSAPP_TRANSPORT="mock"
WHATSAPP_VERIFY_TOKEN="dev-verify-token"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

QUICKBOOKS_CONNECTOR="mock"
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""

# Cloud Drive: set CLOUD_DRIVE_CONNECTOR=google_drive + client id/secret from a
# Google Cloud OAuth app to import from a "RelaTax Reports" Drive folder for real.
CLOUD_DRIVE_CONNECTOR="mock"
CLOUD_DRIVE_CLIENT_ID=""
CLOUD_DRIVE_CLIENT_SECRET=""

# AI: set AI_PROVIDER=anthropic and provide a key to use real Claude generation.
# Retrieval always runs on pgvector; only the answer generation switches.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# Email: set EMAIL_PROVIDER=smtp + host/user/pass to send real verification,
# reset, and notification email. Works with any SMTP provider (SES, SendGrid,
# Postmark, Mailgun, Gmail with an app password).
EMAIL_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RelaTax <no-reply@relatax.org>"

# Public URL this API is reachable at — used to build OAuth redirect URIs
# (cloud drive) and must be a real public HTTPS URL in production.
# Production: API_BASE_URL="https://api.relatax.org"
API_BASE_URL="http://localhost:4000"

# The single web app (marketing + client portal + admin, all one deployment).
# Used in password-reset/email-verification links, the cloud-drive/QuickBooks
# OAuth callback redirects (never returning tokens to the browser), and as
# the allowed CORS origin.
# Production: APP_URL="https://relatax.org"
APP_URL="http://localhost:3000"

# Error tracking: set a Sentry DSN to forward 5xx exceptions there.
# Without it, errors are still logged to the console/stdout with full stack traces.
SENTRY_DSN=""

# Basic-auth credentials for the /admin/queues job dashboard (Bull Board).
# Change these before deploying anywhere reachable outside your own machine.
BULL_BOARD_USER="admin"
BULL_BOARD_PASS="change-me"

PORT=4000
