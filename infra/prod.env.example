# Production environment for docker-compose.prod.yml.
#   cp prod.env.example prod.env    # prod.env is gitignored — never commit it
#
# This single file is read twice: Compose interpolates ${...} from it, and the
# api container receives all of it as its environment.

# ---- Database (used to build DATABASE_URL; no port is published) -----------
POSTGRES_USER="relatax"
POSTGRES_PASSWORD="generate-a-strong-one"
POSTGRES_DB="relatax"

# DATABASE_URL and REDIS_URL are set by docker-compose.prod.yml to point at the
# postgres/redis services — do not set them here.

# ---- Image tag ------------------------------------------------------------
RELEASE_TAG="v1"

# ---- Public URLs ----------------------------------------------------------
APP_URL="https://relatax.org"
API_BASE_URL="https://api.relatax.org"
# Baked into the browser bundle at build time. Rebuild after changing it.
NEXT_PUBLIC_API_URL="https://api.relatax.org/api/v1"

# Cloudflare + Caddy sit in front of the API, so two hops of X-Forwarded-For
# must be unwound to recover the real client IP for rate limiting.
TRUST_PROXY_HOPS="2"

# ---- Secrets — generate fresh, never reuse the dev values ------------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---- Object storage: Cloudflare R2 (S3-compatible) -------------------------
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="relatax-documents"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_FORCE_PATH_STYLE="true"

# ---- Email: Google Workspace on relatax.org --------------------------------
# SMTP_PASS is a Google App Password for info@relatax.org (needs 2-Step
# Verification enabled on that account first), not the account password.
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@relatax.org"
SMTP_PASS=""
SMTP_FROM="RelaTax <info@relatax.org>"

# ---- Integrations ---------------------------------------------------------
# Flip to "meta" once the webhook is reachable at
# https://api.relatax.org/api/v1/whatsapp/webhook
WHATSAPP_TRANSPORT="mock"
WHATSAPP_VERIFY_TOKEN="pick-a-random-string"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

QUICKBOOKS_CONNECTOR="mock"
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""

# Google Cloud OAuth client — the same client also backs "Sign in with Google".
# Authorised redirect URIs must include:
#   https://api.relatax.org/api/v1/cloud-drive/callback
#   https://api.relatax.org/api/v1/auth/google/callback
CLOUD_DRIVE_CONNECTOR="google_drive"
CLOUD_DRIVE_CLIENT_ID=""
CLOUD_DRIVE_CLIENT_SECRET=""

AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# ---- Operations -----------------------------------------------------------
SENTRY_DSN=""

# Guards the /admin/queues job dashboard. Change both.
BULL_BOARD_USER="relatax"
BULL_BOARD_PASS="generate-a-strong-one"

PORT=4000
